# Copy to .env for local testing. Never commit a real token.
PROCESSING_API_TOKEN=replace-with-a-random-token-at-least-32-characters
PROCESSING_BIND_ADDRESS=127.0.0.1
PROCESSING_PORT=8080
# Legacy cluster/main endpoint names remain supported. Empty means unconfigured.
LOCAL_NODE_URL=
MAIN_NODE_URL=
# Optional existing NodeODM/NodeODX query-token credentials. Never commit values.
LOCAL_NODE_TOKEN=
MAIN_NODE_TOKEN=
# Planning limits only; benchmark before dispatching real work.
LOCAL_MAX_PHOTOS=1000
LOCAL_MAX_INPUT_BYTES=21474836480
# Ordered fleet IDs; up to eight nodes. The first is preferred when eligible.
PROCESSING_PROTOTYPE_NODE_IDS=cluster,main
# Additional/custom node settings use the uppercased ID with punctuation mapped
# to underscores, e.g. PROCESSING_NODE_MIDDLE_URL, _TOKEN and optional
# _MAX_INPUT_BYTES. For cluster/main, these names can replace the legacy values.
# Node tokens must be unique; keep all credentials in the private runtime env.
# PROCESSING_NODE_MIDDLE_URL=
# PROCESSING_NODE_MIDDLE_TOKEN=
# PROCESSING_NODE_MIDDLE_MAX_INPUT_BYTES=
PROCESSING_TREEDAR_NODE_IDS=main
# Native Viewer trial: opt in only with the existing durable coordinator state.
PROCESSING_VIEWER_ENABLED=0
PROCESSING_VIEWER_TOKEN=
PROCESSING_VIEWER_STAGING_TOKEN=
PROCESSING_VIEWER_MAX_INPUT_BYTES=21474836480
PROCESSING_VIEWER_MAX_ARCHIVE_BYTES=107374182400
