{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate direct source acceptance receipt envelope",
  "description": "Design-only; validation alone does not prove custody or authorize release.",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "schemaVersion", "issuerId", "keyId", "body", "signature"],
  "properties": {
    "protocol": {"const": "ltds.viewer.source-acceptance/v1"},
    "schemaVersion": {"const": 1},
    "issuerId": {"$ref": "#/$defs/slug"}, "keyId": {"$ref": "#/$defs/slug"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}(?![\\s\\S])"},
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["receiptId", "operationId", "issuedAt", "coordinatorAuthorityId", "viewerPrincipalId", "viewerDestinationId", "submissionId", "viewerTaskId", "viewerAttemptId", "jobId", "generation", "environment", "intakeProtocol", "mode", "modeRevision", "submissionIntentSha256", "sourceSnapshotSha256", "originalPathInventorySha256", "sourceManifestSha256", "derivedManifestSha256", "engineMappingSha256", "workerClosureReceiptSha256", "sourceObjects", "derivedObjects", "retentionGuarantee"],
      "properties": {
        "receiptId": {"$ref": "#/$defs/uuid"}, "operationId": {"$ref": "#/$defs/uuid"},
        "coordinatorAuthorityId": {"$ref": "#/$defs/uuid"}, "submissionId": {"$ref": "#/$defs/uuid"},
        "viewerTaskId": {"$ref": "#/$defs/uuid"}, "viewerAttemptId": {"$ref": "#/$defs/uuid"}, "jobId": {"$ref": "#/$defs/uuid"},
        "issuedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"},
        "viewerPrincipalId": {"$ref": "#/$defs/slug"}, "viewerDestinationId": {"$ref": "#/$defs/slug"},
        "generation": {"$ref": "#/$defs/positiveInteger"}, "modeRevision": {"$ref": "#/$defs/positiveInteger"},
        "environment": {"enum": ["production", "staging"]}, "intakeProtocol": {"const": "ltds-direct-intake-v1"}, "mode": {"const": "direct"},
        "submissionIntentSha256": {"$ref": "#/$defs/hash"}, "sourceSnapshotSha256": {"$ref": "#/$defs/hash"},
        "originalPathInventorySha256": {"$ref": "#/$defs/hash"}, "sourceManifestSha256": {"$ref": "#/$defs/hash"},
        "derivedManifestSha256": {"$ref": "#/$defs/hash"}, "engineMappingSha256": {"$ref": "#/$defs/hash"},
        "workerClosureReceiptSha256": {"$ref": "#/$defs/hash"},
        "sourceObjects": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/object"}},
        "derivedObjects": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/object"}},
        "retentionGuarantee": {"const": "until_explicit_source_release_v1"}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"},
    "slug": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "object": {"type": "object", "additionalProperties": false, "required": ["id", "byteSize", "sha256"], "properties": {"id": {"$ref": "#/$defs/slug"}, "byteSize": {"$ref": "#/$defs/positiveInteger"}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
